# Supabase Postgres (Session pooler). URL-encode special chars in the password (@ -> %40).
DATABASE_URL=

# JWT issued by the Backend (must match Backend's Jwt section).
JWT_SECRET=
JWT_ISSUER=METANOIA
JWT_AUDIENCE=METANOIA.Client
# Allowed clock difference in seconds (same as .NET default ClockSkew).
JWT_LEEWAY_SECONDS=300

# K_bias learning (FR-17). Alpha must be in (0, 0.30]: the DB rejects larger values.
KBIAS_ALPHA=0.2
KBIAS_INITIAL=1.3
# Skip a task when actual/estimate is above this ratio or below 1/ratio.
KBIAS_OUTLIER_RATIO=5

# Schedule proposal (FR-10).
SCHEDULE_WINDOW_DAYS=7
# A task split over several slots: each part is at least this long.
SCHEDULE_MIN_CHUNK_MINUTES=30
# Every slot starts on a multiple of this many minutes (rounded up).
SCHEDULE_ROUND_MINUTES=5
SCHEDULE_TOP_PRODUCTIVE_HOURS=3
# Anti-spam: max AI calls per user in 24 hours.
QUOTA_DAILY_MAX=50

# LLM (Google Gemini). The service starts without these; LLM features fail until set.
LLM_MODEL=
GEMINI_API_KEY=
# Retries after a bad or failed LLM answer (2 = up to 3 calls).
LLM_MAX_RETRIES=2
# Price per 1 million tokens, used for AIUsageLog.Cost (currency: ask the Backend).
LLM_INPUT_PRICE_PER_1M=
LLM_OUTPUT_PRICE_PER_1M=

# Embedding + long-term memory (FR-19). Uses GEMINI_API_KEY above.
# The service starts without these; memories stay Pending until they are set.
EMBEDDING_MODEL=
# Must match the DB column TaskExecutionMemory.Embedding (vector(1536)).
EMBEDDING_DIMENSIONS=1536
# Price per 1 million input tokens, used for AIUsageLog.Cost.
EMBEDDING_PRICE_PER_1M=
MEMORY_TEXT_MAX_CHARS=1000

# Similar tasks (FR-09). Defaults are fine; tune with real data.
SIMILAR_MIN_SIMILARITY=0.5
SIMILAR_RRF_K=60
SIMILAR_BRANCH_LIMIT=20
SIMILAR_DEFAULT_LIMIT=5
# Seconds to wait for the query vector before searching text only.
SIMILAR_EMBED_TIMEOUT_SECONDS=1.5

# Task chat (FR-08a). Defaults are fine.
CHAT_HISTORY_LIMIT=20
CHAT_MESSAGE_MAX_CHARS=2000
BREAKDOWN_MIN_SUBTASKS=2
BREAKDOWN_MAX_SUBTASKS=10
# Minutes per subtask: AI drafts 5-120; manual edits at Apply up to 480.
BREAKDOWN_MIN_MINUTES=5
BREAKDOWN_MAX_MINUTES=120
BREAKDOWN_MANUAL_MAX_MINUTES=480
# Warn when the subtask total differs from the adjusted time by more than 30%.
BREAKDOWN_WARNING_RATIO=0.3
# Seconds to wait for one Gemini answer in the chat (at least 10).
CHAT_LLM_TIMEOUT_SECONDS=20

# Project chat (FR-08b-1): brief -> milestones + tasks. Defaults are fine.
CHAT_PROJECT_MESSAGE_MAX_CHARS=8000
# The brief (first message) is always sent, plus this many recent messages.
CHAT_PROJECT_HISTORY_LIMIT=10
CHAT_PROJECT_PROMPT_MAX_CHARS=30000
CHAT_PROJECT_EXISTING_TITLES_LIMIT=50
PROJECT_MAX_MILESTONES=8
PROJECT_MAX_TASKS_PER_MILESTONE=15
PROJECT_MAX_TASKS=40
# Minutes per task: AI drafts 15-480; manual edits at Apply 5-960.
PROJECT_TASK_MIN_MINUTES=15
PROJECT_TASK_MAX_MINUTES=480
PROJECT_MANUAL_MIN_MINUTES=5
PROJECT_MANUAL_MAX_MINUTES=960
# Milestone.Name is varchar(150): 150 at most.
PROJECT_MILESTONE_TITLE_MAX_CHARS=150
# Work hours per day for the overload warning.
CHAT_DAILY_WORK_HOURS=6
# Seconds to wait for one Gemini answer (at least 10); no retry after the budget.
CHAT_PROJECT_LLM_TIMEOUT_SECONDS=30
CHAT_PROJECT_RETRY_BUDGET_SECONDS=40
# Retries after a bad or failed answer (0-2).
CHAT_PROJECT_MAX_RETRIES=1

# Productive hours (FR-18). Scores in [0, 1]; selected must be higher than unselected.
ONBOARDING_SELECTED_SCORE=0.8
ONBOARDING_UNSELECTED_SCORE=0.3
# The onboarding answer counts like this many sessions in the learned score.
PRODUCTIVE_PRIOR_WEIGHT=5
# A session stopped for "Other" counts as good only if at least this many minutes.
PRODUCTIVE_MIN_SESSION_MINUTES=25
PRODUCTIVE_HOURS_WINDOW_DAYS=90
# Plan names (SubscriptionPlan.Name) that learn from timer data, comma-separated.
PRODUCTIVE_LEARNING_PLANS=Cao cấp
