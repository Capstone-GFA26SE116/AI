# Supabase Postgres (Session pooler). URL-encode special chars in the password (@ -> %40).
DATABASE_URL=

# JWT issued by the Backend (must match Backend's Jwt section).
JWT_SECRET=
JWT_ISSUER=METANOIA
JWT_AUDIENCE=METANOIA.Client
# Allowed clock difference in seconds (same as .NET default ClockSkew).
JWT_LEEWAY_SECONDS=300
